{
	"info": {
		"_postman_id": "0908bee1-655d-4a1d-9f5e-dd8d5ac226c9",
		"name": "Anyday",
		"description": "# Introduction\nAutomate test tool to help dev/qa to check on the basic payment functions.\n\n# Overview\n* Your must select the Environment.\n* \"Initial / Initial\" request must be run.\n* \"Login / Login as superadmin\" request can generate admin token.\n* \"Login / Login as merchant\" or \"Merchant / Create merchant\" request can generate merchant/webshop token.\n* \"Login / Login as debtor\" or \"Debtor / Create debtor\" request can generate debtor token.\n\n# Authentication\nUsing Bearer token which can get by \"Login\", \"Create debtor\" or \"Create merchant\".",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "9782619"
	},
	"item": [
		{
			"name": "Initial",
			"item": [
				{
					"name": "Initial",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.globals.set('loadUtils', function loadUtils() {\r",
									"    const authNames = {\r",
									"        admin: 'admin_auth',\r",
									"        merchant: 'merchant_auth',\r",
									"        debtor: 'debtor_auth'\r",
									"    };\r",
									"    let utils = {};\r",
									"    let useToken = function (name) {\r",
									"        try {\r",
									"            const data = JSON.parse(pm.collectionVariables.get(name));\r",
									"            pm.collectionVariables.set(\"token\", data.auth.access_token);\r",
									"            pm.collectionVariables.set(\"refresh_token\", data.auth.refresh_token);\r",
									"            pm.collectionVariables.set(\"current_user\", data.email);\r",
									"            pm.collectionVariables.set(\"current_auth\", data.auth_name);\r",
									"        }\r",
									"        catch {\r",
									"            throw new Error(name + ' is invalid.');\r",
									"        }\r",
									"    };\r",
									"    let saveToken = function (name, data) {\r",
									"        data.auth_name = name;\r",
									"        pm.collectionVariables.set(name, JSON.stringify(data));\r",
									"    };\r",
									"\r",
									"    utils.useAdminToken = function useAdminToken() {\r",
									"        console.log('Using admin token');\r",
									"        useToken(authNames.admin);\r",
									"    };\r",
									"    utils.useMerchantToken = function useMerchantToken() {\r",
									"        console.log('Using merchant token');\r",
									"        useToken(authNames.merchant);\r",
									"\r",
									"        const data = JSON.parse(pm.collectionVariables.get(authNames.merchant));\r",
									"        pm.collectionVariables.set(\"merchant_user\", data.email);\r",
									"    };\r",
									"    utils.useWebShopToken = function useWebShopToken() {\r",
									"        console.log('Using webshop token');\r",
									"        useToken(authNames.merchant);\r",
									"\r",
									"        const data = JSON.parse(pm.collectionVariables.get(authNames.merchant));\r",
									"        pm.collectionVariables.set(\"token\", data.apiKey);\r",
									"        pm.collectionVariables.set(\"merchant_user\", data.email);\r",
									"    };\r",
									"    utils.useDebtorToken = function useDebtorToken() {\r",
									"        console.log('Using debtor token');\r",
									"        useToken(authNames.debtor);\r",
									"\r",
									"        const data = JSON.parse(pm.collectionVariables.get(authNames.debtor));\r",
									"        pm.collectionVariables.set(\"debtor_user\", data.email);\r",
									"    };\r",
									"    utils.saveAdminToken = function setAdminToken(data) {\r",
									"        console.log('Saved admin token');\r",
									"        saveToken(authNames.admin, data);\r",
									"        this.useAdminToken();\r",
									"    };\r",
									"    utils.saveMerchantToken = function setMerchantToken(data) {\r",
									"        console.log('Saved merchant token');\r",
									"        saveToken(authNames.merchant, data);\r",
									"        this.useMerchantToken();\r",
									"    };\r",
									"    utils.saveDebtorToken = function setDebtorToken(data) {\r",
									"        console.log('Saved debtor token');\r",
									"        saveToken(authNames.debtor, data);\r",
									"        this.useDebtorToken();\r",
									"    };\r",
									"\r",
									"    utils.verifyCollectionVariable = function verifyCollectionVariable(name) {\r",
									"        const value = pm.collectionVariables.get(name);\r",
									"        if (!value) {\r",
									"            throw new Error('No value for ' + name + ' variable.');\r",
									"        }\r",
									"    };\r",
									"    return utils;\r",
									"} + '; loadUtils();');\r",
									"tests['Utils initialized'] = true;"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Should be success\", function() {\r",
									"    pm.response.to.be.success;\r",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{dummy_url}}",
							"host": [
